name: C++ CMake CI

on:
  push:
    branches: [ main ]

  pull_request:
    branches: [ main ]

jobs:

  build:
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
        build_type: [Debug, Release]

    runs-on: ${{ matrix.os }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Configure CMake
        run: cmake -S . -B build -DCMAKE_BUILD_TYPE=${{ matrix.build_type }}

      - name: Build
        run: cmake --build build --config ${{ matrix.build_type }}

      - name: Upload Build Artifact
        uses: actions/upload-artifact@v6
        with:
          name: build-${{ matrix.os }}-${{ matrix.build_type }}
          path: build/


  test:
    needs: build

    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
        build_type: [Debug, Release]

    runs-on: ${{ matrix.os }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Download Build Artifact
        uses: actions/download-artifact@v7
        with:
          name: build-${{ matrix.os }}-${{ matrix.build_type }}
          path: build/

      - name: Run Tests
        run: ctest --test-dir build --output-on-failure -C ${{ matrix.build_type }}
  package:
    needs: test
    runs-on: ubuntu-latest

    steps:
      - name: Download Release Artifacts
        uses: actions/download-artifact@v7
        with:
          pattern: build-*-Release
          path: release-builds
          merge-multiple: false

      - name: Create Package
        run: |
          mkdir package
          cp -r release-builds package/builds
          tar -czf MyProject.tar.gz package

      - name: Upload Package
        uses: actions/upload-artifact@v6
        with:
          name: MyProject-Package
          path: MyProject.tar.gz
  release:
    needs: package
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Download Package
        uses: actions/download-artifact@v7
        with:
          name: MyProject-Package
          path: release

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.${{ github.run_number }}
          name: MyProject v1.0.${{ github.run_number }}
          files: release/MyProject.tar.gz
  deploy:
    needs: release
    runs-on: ubuntu-latest

    steps:
      - name: Download Package
        uses: actions/download-artifact@v7
        with:
          name: MyProject-Package
          path: deploy

      - name: Deploy Application
        run: |
          echo "Starting deployment..."
          echo "Package contents:"
          ls -lh deploy
          echo "Deploying MyProject..."
          echo "Deployment completed successfully!"
